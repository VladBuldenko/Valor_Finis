# Valor Finis — root environment example
# Copy this file to .env for local Docker development.
# Never commit real credentials.


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/valor


# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------

# Required. The API fails to start if this is absent, blank, or set to
# an unsupported value — there is no implicit default.
# Supported values:
# development — local/test use only (X-User-Id header, no signature check)
# supabase    — production; use this explicitly in deployed environments
AUTH_MODE=development

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
RECEIPT_STORAGE_BUCKET=receipts


# ------------------------------------------------------------
# Receipt storage
# ------------------------------------------------------------

RECEIPT_STORAGE_DRIVER=local
RECEIPT_UPLOAD_DIR=uploads/receipts
RECEIPT_MAX_FILE_SIZE_MB=10

# ------------------------------------------------------------
# Periodic dispatcher (VF-020E10) - read by the separate process
#   python -m app.modules.financial_rules.dispatcher
# All optional; see docs/operations/rule-dispatcher.md. Invalid values stop the
# process with exit code 2 before any work.
# ------------------------------------------------------------
# RULE_DISPATCHER_ENABLED=true
# RULE_DISPATCHER_MAX_USERS=50
# RULE_DISPATCHER_MAX_EVENTS_PER_USER=20
# RULE_DISPATCHER_MAX_ALERT_USERS=200
# RULE_DISPATCHER_TIME_BUDGET_SECONDS=240
# RULE_DISPATCHER_INTERVAL_SECONDS=600
