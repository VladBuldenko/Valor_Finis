# Valor Finis API — local standalone environment example
# Copy this file to services/api/.env when running FastAPI
# directly on the host machine.


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/valor


# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------

AUTH_MODE=development

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=


# ------------------------------------------------------------
# Receipt storage
# ------------------------------------------------------------

RECEIPT_STORAGE_DRIVER=local
RECEIPT_UPLOAD_DIR=uploads/receipts
RECEIPT_MAX_FILE_SIZE_MB=10

# OCR provider used to extract text from uploaded receipt images.
# "tesseract" uses the open-source Tesseract OCR engine (requires the
# tesseract-ocr OS package; already installed in the Docker image — running
# the API directly on the host instead of Docker requires installing it
# locally, e.g. `brew install tesseract tesseract-lang` on macOS).
# "unconfigured" explicitly disables OCR (processing requests always fail).
RECEIPT_OCR_DRIVER=tesseract

# Maximum decoded receipt image pixel count (width * height) allowed
# before OCR processing. Protects against decompression-bomb-style images
# that are small on disk but decode into an oversized in-memory bitmap,
# and bounds per-request memory on a modest production container where a
# sync OCR route can hold this footprint concurrently across requests.
# Default (30,000,000) comfortably covers standard 12-24MP iPhone photos
# with headroom, while staying well below Pillow's own decompression-bomb
# warning threshold (~89,478,485 pixels). Unusually high-resolution
# 44-48MP ProRAW/HEIF-max photos fall outside this MVP budget; see the
# rationale comment on DEFAULT_RECEIPT_OCR_MAX_IMAGE_PIXELS in
# app/core/app_config.py for the full memory analysis.
RECEIPT_OCR_MAX_IMAGE_PIXELS=30000000

# Maximum Tesseract OCR execution time, in seconds, allowed per receipt.
# Bounds worst-case CPU/wall-clock time so a single pathological or
# adversarial image cannot tie up an application worker indefinitely.
RECEIPT_OCR_TIMEOUT_SECONDS=20